# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
POSTGRES_PASSWORD=change-me
AGENT_API_TOKEN=change-me-long-random-string
# Offline deterministic provider (default; no network, no key):
AGENT_PROVIDER=rule
# To use a real model server instead:
# AGENT_PROVIDER=openai_compat
# AGENT_BASE_URL=https://api.openai.com/v1      # or http://host.docker.internal:11434/v1 for Ollama
# AGENT_MODEL=gpt-4o-mini
# AGENT_API_KEY=sk-...
